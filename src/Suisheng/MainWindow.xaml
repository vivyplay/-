<Window x:Class="Suisheng.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="随声输入" Width="1040" Height="790" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242238"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242238"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#242238"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="LineHeight" Value="23"/></Style>
  </Window.Resources>
  <Grid Margin="30,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="随声输入" FontSize="29" FontWeight="Bold"/><TextBlock Text="让想法自然落笔。按下快捷键，说出你想写的内容。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="阶段 3  ·  本地优先 + 可选 AI" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Border>
    </Grid>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
      <TabItem Header="语音输入"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
        <Border Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="18" Padding="26"><StackPanel>
          <DockPanel><TextBlock x:Name="StatusText" Text="待机" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="TimerText" Text="00:00" Foreground="#C5BDDB" FontSize="19" HorizontalAlignment="Right"/></DockPanel>
          <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#D2CCDF" Margin="0,12,0,18" LineHeight="24"/>
          <ProgressBar x:Name="LevelBar" Height="5" Minimum="0" Maximum="100" Foreground="#BCA6FF" Background="#49405E" BorderThickness="0"/>
          <TextBlock x:Name="HotkeyText" Foreground="#CBB9FF" Margin="0,15,0,0"/>
          <TextBlock x:Name="DeviceText" Foreground="#CBB9FF" Margin="0,6,0,0"/>
        </StackPanel></Border>
        <WrapPanel Margin="0,16,0,18"><Button x:Name="RecordButton" Content="开始录音" Click="Record_Click" Background="#7452CF" Foreground="White" BorderThickness="0" Padding="24,11"/><Button x:Name="CancelButton" Content="取消任务" Click="Cancel_Click"/><Button x:Name="MicrophoneButton" Content="测试麦克风" Click="TestMicrophone_Click"/><Button Content="打开设置" Click="OpenSettings_Click"/></WrapPanel>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,16"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="OpenAiButton" Content="AI 提示词面板" Click="OpenAi_Click" VerticalAlignment="Center"/></WrapPanel><StackPanel><CheckBox x:Name="AiEnabledBox" Content="识别后使用 AI 优化（默认关闭）" Checked="AiEnabled_Click" Unchecked="AiEnabled_Click" Margin="0,0,0,3"/><TextBlock x:Name="AiStateText" Text="关闭时仅在本地处理，不发送优化请求。" Style="{StaticResource Hint}" FontSize="12"/></StackPanel></DockPanel></Border>
        <TextBlock Text="处理后结果 · 自动输入仅使用此文字" Style="{StaticResource Heading}" FontSize="16"/>
        <TextBox x:Name="ResultBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,8,0,0"/>
        <TextBlock Text="原始识别 · 仅保留在本次内存中" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,5"/>
        <TextBox x:Name="OriginalResultBox" Height="75" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="CopyButton" Content="复制结果" Click="Copy_Click"/><Button x:Name="RetryButton" Content="选择目标后写入…" Click="Retry_Click"/><Button x:Name="ClearButton" Content="清除本次结果" Click="Clear_Click"/></WrapPanel>
        <TextBlock Text="不保存录音。不自动发送、提交表单或执行命令；目标或光标改变时停止自动写入。" Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,8"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="模型与录音"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="4,18,12,0">
        <TextBlock Text="AI 提示词优化" Style="{StaticResource Heading}"/>
        <TextBlock Text="与本地语音识别独立配置。开启后发送识别文字、优化要求和模板，不发送音频；结果默认预览确认。" Style="{StaticResource Hint}" Margin="0,6,0,4"/>
        <DockPanel><Button x:Name="OpenAiSettingsButton" Content="打开 AI 配置与模板" DockPanel.Dock="Right" Click="OpenAi_Click"/><CheckBox x:Name="AiSettingsEnabledBox" Content="启用 AI 优化" Checked="AiEnabled_Click" Unchecked="AiEnabled_Click" VerticalAlignment="Center"/></DockPanel>
        <Separator Margin="0,12"/>
        <TextBlock Text="离线识别模型" Style="{StaticResource Heading}"/><TextBlock Text="模型下载不发送音频。Tiny 适合试用但中文错字较多，Base 较大且通常更准确。" Style="{StaticResource Hint}" Margin="0,8,0,12"/>
        <ComboBox x:Name="ModelCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock Text="下载源（手动选择，不会自动切换）" Margin="0,12,0,6"/><ComboBox x:Name="SourceCombo"><ComboBoxItem Content="Hugging Face 官方源" Tag="official"/><ComboBoxItem Content="hf-mirror.com 第三方镜像 · 同一 SHA-256 校验" Tag="mirror"/></ComboBox>
        <TextBlock Text="模型目录" Margin="0,12,0,6"/><DockPanel><Button Content="选择目录" DockPanel.Dock="Right" Click="BrowseDirectory_Click" Margin="10,0,0,0"/><TextBox x:Name="ModelDirectoryBox"/></DockPanel>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="DownloadButton" Content="下载并校验模型" Click="Download_Click"/><Button x:Name="ImportButton" Content="导入本地模型" Click="Import_Click"/></WrapPanel>
        <ProgressBar x:Name="DownloadBar" Height="6" Margin="0,12,0,5" Maximum="100" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="ModelStatus" Style="{StaticResource Hint}" FontSize="12"/>
        <Separator Margin="0,16"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="麦克风" Margin="0,0,0,6"/><ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/><Button Content="刷新设备" Click="RefreshDevices_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="识别语言" Margin="0,0,0,6"/><ComboBox x:Name="LanguageCombo"><ComboBoxItem Content="中文（普通话）" Tag="zh"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="自动检测 / 中英混合" Tag="auto"/></ComboBox></StackPanel>
        </Grid>
        <TextBlock Text="录音模式（按住模式仅作用于快捷键；按钮和悬浮球仍为单击切换）" Margin="0,14,0,6"/>
        <ComboBox x:Name="RecordingModeCombo"><ComboBoxItem Content="切换模式 · 按一次开始，再按一次结束" Tag="toggle"/><ComboBoxItem Content="按住说话 · 按住快捷键录音，松开结束" Tag="hold"/></ComboBox>
        <CheckBox x:Name="SilenceDetectionBox" Content="检测到声音后，连续静音自动结束录音（阈值型，不是完整 VAD）"/>
        <DockPanel><TextBlock Text="静音等待秒数（0.5–10）" VerticalAlignment="Center"/><TextBox x:Name="SilenceSecondsBox" Width="110" HorizontalAlignment="Right"/></DockPanel>
        <TextBlock Text="全局快捷键 · 点击输入框后按下新组合" Margin="0,14,0,6"/><DockPanel><Button Content="恢复默认快捷键" DockPanel.Dock="Right" Click="DefaultHotkey_Click" Margin="10,0,0,0"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/></DockPanel>
        <TextBlock x:Name="HotkeyHint" Text="至少同时按住 Ctrl、Alt、Shift 或 Win 中的一项，再按普通按键；保存后立即生效。" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"/>
        <DockPanel Margin="0,14,0,0"><TextBlock Text="最长录音时间（5–600 秒）" VerticalAlignment="Center"/><TextBox x:Name="MaxSecondsBox" Width="110" HorizontalAlignment="Right"/></DockPanel>
        <CheckBox x:Name="CloseToTrayBox" Content="关闭主面板时最小化到托盘，保留悬浮球"/>
        <CheckBox x:Name="StartMinimizedBox" Content="打开软件时仅显示悬浮球和托盘"/>
        <CheckBox x:Name="StartupBox" Content="登录 Windows 时自动启动（不会自动录音）" Click="Startup_Click"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="文字处理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,24,12,0">
        <TextBlock Text="识别后的文字处理" Style="{StaticResource Heading}" FontSize="22"/>
        <TextBlock Text="以下处理发生在本地识别之后，不是模型热词增强。替换表用于修正人名、公司名和专业术语。" Style="{StaticResource Hint}" Margin="0,10,0,18"/>
        <CheckBox x:Name="KeepOriginalBox" Content="保留原始识别结果（关闭后新结果与历史均不保留原文）"/>
        <CheckBox x:Name="AutoPunctuationBox" Content="句尾没有标点时，按识别语言补充句号"/>
        <CheckBox x:Name="BasicFormattingBox" Content="基础排版 · 合并多余空格和 Tab，移除首尾空白"/>
        <CheckBox x:Name="RemoveFillerWordsBox" Content="可选口语词清理 · 仅清理明确分隔的“嗯、呃、um”等，默认关闭"/>
        <TextBlock Text="自定义词语替换 · 每行：原词 =&gt; 替换词" Style="{StaticResource Heading}" FontSize="16" Margin="0,18,0,6"/>
        <TextBox x:Name="ReplacementRulesBox" Height="190" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        <TextBlock Text="最长原词优先、区分字面文字、不执行正则表达式或命令。最多 200 条；替换后若包含换行等控制字符，将拒绝自动写入。取消识别或删除本次结果不会自动清除已保存的历史。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="悬浮球外观"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,24,12,0">
        <TextBlock x:Name="AppearanceHeading" Text="悬浮球外观与主题" Style="{StaticResource Heading}" FontSize="22"/>
        <TextBlock Text="外观在保存所有设置后立即生效。图片将复制到软件自己的用户数据目录，不移动或修改原图片。" Style="{StaticResource Hint}" Margin="0,10,0,15"/>
        <DockPanel><TextBlock Text="界面主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Width="260" HorizontalAlignment="Right"><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/><ComboBoxItem Content="跟随 Windows 系统" Tag="system"/></ComboBox></DockPanel>
        <DockPanel Margin="0,12,0,0"><TextBlock Text="内置形象" VerticalAlignment="Center"/><ComboBox x:Name="OrbStyleCombo" Width="260" HorizontalAlignment="Right" SelectionChanged="Appearance_Changed"><ComboBoxItem Content="紫色声波" Tag="wave"/><ComboBoxItem Content="紫色话筒" Tag="microphone"/><ComboBoxItem Content="紫色对话" Tag="chat"/></ComboBox></DockPanel>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="220" Height="220" CornerRadius="110" Background="{DynamicResource AccentSoftBrush}" Padding="10"><Grid x:Name="AvatarPreviewHost" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"><Ellipse x:Name="AvatarPreview" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" Cursor="SizeAll"/></Grid></Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0">
            <WrapPanel><Button Content="选择 PNG / JPEG 图片…" Click="ChooseAvatar_Click"/><Button Content="恢复内置形象" Click="ResetAvatar_Click"/></WrapPanel>
            <TextBlock x:Name="AvatarStatus" Style="{StaticResource Hint}" Margin="0,10,0,12"/>
            <TextBlock Text="图片缩放（1–4 倍），可在预览上拖动调整裁剪位置"/>
            <Slider x:Name="AvatarZoomSlider" Minimum="1" Maximum="4" TickFrequency="0.1" ValueChanged="Appearance_Changed" Margin="0,10,0,16"/>
            <TextBlock Text="悬浮球大小（48–160）"/><Slider x:Name="BallSizeSlider" Minimum="48" Maximum="160" TickFrequency="1" Margin="0,10,0,16"/>
            <TextBlock Text="不透明度（40%–100%，不会完全隐藏）"/><Slider x:Name="BallOpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.05" Margin="0,10,0,8"/>
            <TextBlock Text="自定义图片不能遮挡独立状态文字；录音时显示“录音”和秒数。支持本地 PNG 透明背景，不支持动画。" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Grid>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="历史与隐私"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,24,12,0">
        <TextBlock Text="可选的本地识别历史" Style="{StaticResource Heading}" FontSize="22"/>
        <CheckBox x:Name="HistoryEnabledBox" Content="主动开启长期历史（默认关闭；关闭只停止新增，不静默删除已有记录）"/>
        <DockPanel Margin="0,4,0,12"><TextBlock Text="保留期限（1–3650 天，最多显示和保留最新 100 条）" VerticalAlignment="Center"/><TextBox x:Name="HistoryDaysBox" Width="110" HorizontalAlignment="Right"/></DockPanel>
        <TextBlock Text="历史以未加密的 JSON 文件保存在当前 Windows 用户的 %LOCALAPPDATA%\Suisheng 目录。不含录音、目标窗口文字或密钥；请不要在共享账户中保存敏感识别内容。过期项在读取或新增时清理。" Style="{StaticResource Hint}" Margin="0,0,0,15"/>
        <ListBox x:Name="HistoryList" Height="190" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="History_SelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedAt, StringFormat=MM-dd HH:mm}"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBox x:Name="HistoryDetailBox" Height="85" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="HistoryCopyButton" Content="复制选中记录" Click="HistoryCopy_Click"/><Button x:Name="HistoryDeleteButton" Content="删除选中记录" Click="HistoryDelete_Click"/><Button x:Name="HistoryClearButton" Content="一键清空历史…" Click="HistoryClear_Click"/></WrapPanel>
        <TextBlock x:Name="HistoryStatus" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="阶段与帮助"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24">
        <TextBlock Text="先把基础做好，再逐阶段扩展。" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Hint}" LineHeight="27" Margin="0,18,0,0" Text="当前版本 0.3.1 · AI 优化阶段&#10;本地识别、按住说话、词语替换、安全写入、主题、可选历史，以及默认关闭的真实外部 AI 提示词优化。&#10;&#10;AI 使用说明&#10;支持 OpenAI 兼容 Chat Completions 完整接口。原文与结果分区保留，可编辑、复制、取消或使用原文。内置通用、简洁、详细任务、编程和仅纠错润色模板，也可新建、修改和删除模板。密钥由 Windows DPAPI 当前用户加密。&#10;&#10;AI 开启且发送优化前，会明确提示文字将发送到所配置服务并可能产生费用；优化结果必须确认后才重新验证输入位置并写入。AI 关闭或配置不完整时，普通本地语音输入仍可使用。"/>
        <Separator Margin="0,22"/>
        <TextBlock Text="使用提示" FontSize="17" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" LineHeight="26" Margin="0,10,0,0" Text="1. 准备模型并测试麦克风。在记事本空白测试页放好光标。&#10;2. 切换模式按一次开始、再按一次结束；按住模式仅对快捷键生效。&#10;3. 悬浮球左键单击切换、拖动移动、右键打开菜单。&#10;4. 静音检测是简单音量阈值，可能受环境噪音影响，请实测后再启用。&#10;5. 文字替换在识别后发生；不会上传原文，也不会把替换表当作模型热词。&#10;&#10;Esc 仅在活动录音/识别任务中注册。无法可靠验证的控件、密码框、只读框和已变化的目标不会自动写入。自动输入提交成功不等于应用已正确接收，请检查结果。Windows 10、多显示器及真人麦克风需要对应环境实测。"/>
        <TextBlock Text="开源组件" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Style="{StaticResource Hint}" Text="NAudio 2.2.1 · MIT&#10;Whisper.net / whisper.cpp · MIT&#10;Whisper 模型 · MIT&#10;完整许可文本随运行包提供。无在线更新服务。"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="SaveButton" Content="保存所有设置" DockPanel.Dock="Right" Click="Save_Click" Background="#7452CF" Foreground="White" BorderThickness="0" Margin="12,0,0,0"/><TextBlock Text="本地处理  /  不存录音  /  不自动发送" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="SUISHENG  ·  0.3.1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/></DockPanel>
  </Grid>
</Window>
