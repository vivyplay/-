<Window x:Class="Suisheng.AiWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="随声输入 · AI 提示词优化" Width="1060" Height="840" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242238"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242238"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#242238"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="LineHeight" Value="21"/></Style>
  </Window.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <CheckBox x:Name="AiEnabledBox" Content="启用 AI 优化" DockPanel.Dock="Right" Checked="AiEnabled_Click" Unchecked="AiEnabled_Click" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <StackPanel><TextBlock Text="AI 提示词优化" FontSize="25" FontWeight="Bold"/><TextBlock Text="默认关闭 · 真实 OpenAI 兼容 Chat Completions · 默认预览确认" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="优化预览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,16,8,0">
        <TextBlock x:Name="SessionStatus" Text="AI 当前关闭，手动编辑原文不会发送网络请求。" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="原文 · 语音识别结果或手动输入" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="OriginalBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="优化结果 · 确认前可编辑" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="ResultBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></StackPanel>
        </Grid>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="优化要求" Margin="0,0,0,6"/><TextBox x:Name="InstructionsBox" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="优化强度" Margin="0,0,0,6"/><ComboBox x:Name="StrengthCombo"><ComboBoxItem Content="轻度 · 尽量保留原句" Tag="light"/><ComboBoxItem Content="适中 · 保留细节并理顺" Tag="balanced"/><ComboBoxItem Content="充分 · 可重组结构" Tag="thorough"/></ComboBox><CheckBox x:Name="AllowExpansionBox" Content="允许必要扩写（不得虚构）"/></StackPanel>
        </Grid>
        <DockPanel Margin="0,10,0,0"><TextBlock Text="提示词模板" VerticalAlignment="Center"/><ComboBox x:Name="TemplateCombo" Width="300" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Right"/></DockPanel>
        <WrapPanel Margin="0,14,0,0"><Button x:Name="OptimizeButton" Content="发送原文并优化…" Click="Optimize_Click" Background="#7452CF" Foreground="White" BorderThickness="0"/><Button x:Name="ReoptimizeButton" Content="按原文重新优化…" Click="Optimize_Click"/><Button x:Name="CancelButton" Content="取消 / 关闭预览" Click="Cancel_Click"/></WrapPanel>
        <WrapPanel><Button x:Name="ConfirmWriteButton" Content="确认结果并选择目标写入…" Click="ConfirmWrite_Click" Background="#7452CF" Foreground="White" BorderThickness="0"/><Button x:Name="UseOriginalButton" Content="使用原文并选择目标写入…" Click="UseOriginal_Click"/><Button x:Name="CopyResultButton" Content="复制结果" Click="CopyResult_Click"/><Button Content="复制原文" Click="CopyOriginal_Click"/></WrapPanel>
        <TextBlock Text="开启 AI 后，语音识别文字会先进行本地处理，再与优化要求和模板一起发送。不会发送音频。AI 返回内容仅作为文本，不执行命令，不自动发送消息或提交表单。含换行的结果不会自动写入，可复制后手动处理。" Style="{StaticResource Hint}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="API 配置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,18,8,0" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="真实服务配置" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="仅支持你明确配置的 OpenAI 兼容 Chat Completions 完整 URL。软件不预设服务商、不自动拼接路径；模型名称和能力以你的服务文档为准。" Style="{StaticResource Hint}" Margin="0,8,0,16"/>
        <TextBlock Text="完整接口地址（公网必须 HTTPS）" Margin="0,0,0,6"/><TextBox x:Name="EndpointBox"/><TextBlock Text="示例不是预设地址；请粘贴服务文档给出的完整 Chat Completions URL。HTTP 仅允许 127.0.0.1、localhost 或 ::1 本机服务。" Style="{StaticResource Hint}" Margin="0,5,0,12"/>
        <TextBlock Text="模型名称" Margin="0,0,0,6"/><TextBox x:Name="ModelBox"/>
        <DockPanel Margin="0,12,0,12"><TextBlock Text="请求超时（5–300 秒）" VerticalAlignment="Center"/><TextBox x:Name="TimeoutBox" Width="110" HorizontalAlignment="Right"/></DockPanel>
        <TextBlock Text="API Key · 留空表示保留已保存密钥" Margin="0,0,0,6"/><PasswordBox x:Name="ApiKeyBox"/>
        <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,4"/>
        <CheckBox x:Name="ClearKeyBox" Content="保存配置时删除已保存的 API Key"/>
        <TextBlock Text="密钥使用 Windows DPAPI CurrentUser 加密，仅当前 Windows 用户可解密。密钥不进入 settings.json、普通日志、测试报告或模板文件。脱敏状态不代表密钥有效。" Style="{StaticResource Hint}" Margin="0,6,0,14"/>
        <WrapPanel><Button x:Name="SaveConfigButton" Content="保存 AI 配置" Click="SaveConfig_Click" Background="#7452CF" Foreground="White" BorderThickness="0"/><Button x:Name="TestConnectionButton" Content="保存并测试真实连接…" Click="TestConnection_Click"/></WrapPanel>
        <TextBlock Text="连接测试会发送一条极短文字请求，可能产生少量费用，执行前会再次确认。没有真实 Key 时不会伪造成功结果。请求失败不自动重试。" Style="{StaticResource Hint}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="模板管理"><Grid Margin="2,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <DockPanel><WrapPanel DockPanel.Dock="Bottom"><Button Content="新建" Click="NewTemplate_Click"/><Button Content="删除" Click="DeleteTemplate_Click"/><Button Content="恢复内置模板…" Click="RestoreTemplates_Click"/></WrapPanel><ListBox x:Name="TemplateList" DisplayMemberPath="Name" SelectedValuePath="Id" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="TemplateList_SelectionChanged"/></DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
          <TextBlock Text="模板名称"/><TextBox x:Name="TemplateNameBox" Margin="0,5,0,10"/>
          <TextBlock Text="用途说明"/><TextBox x:Name="TemplateDescriptionBox" Margin="0,5,0,10"/>
          <TextBlock Text="系统提示词"/><TextBox x:Name="SystemPromptBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,5,0,10"/>
          <TextBlock Text="用户提示词"/><TextBox x:Name="UserPromptBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,5,0,10"/>
          <TextBlock Text="用户提示词必须包含 {{text}} 原文占位符；可使用 {{instructions}} 优化要求占位符。模板只作为文字发送，不赋予 AI 文件、鼠标、键盘或系统权限。" Style="{StaticResource Hint}"/>
          <Button Content="保存当前模板" Click="SaveTemplate_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Background="#7452CF" Foreground="White" BorderThickness="0"/>
          <TextBlock x:Name="TemplateStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
    </TabControl>
    <TextBlock x:Name="GlobalStatus" Grid.Row="2" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"/>
    <TextBlock Grid.Row="3" Text="严格本地识别与 AI 优化分开配置；关闭 AI 后普通语音输入继续可用。" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
  </Grid>
</Window>
